# era_admin_backend settings.
# Copy this file to .env in this folder, fill in the values, then restart the server.
# Never commit .env or a service account key file.
# Every setting is read in one place: config/env.js

# Port the API listens on. If you change it, set AGENCY_API_TARGET in era_web_admin/.env.local to match.
PORT=5000

# Optional. OSRM-compatible routing server used to rank stations by driving time when an incident is routed.
# The default public demo server has no uptime guarantee; use your own for production.
# If it is slow or unreachable, stations are ranked by straight-line distance instead.
ROUTING_URL=https://router.project-osrm.org

# Firebase project (Firebase console > Project settings).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
# Needed to upload advisory cover images.
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Admin credentials (Firebase console > Project settings > Service accounts > Generate new private key).
# Keep the key file outside this repository. Relative paths start from era_admin_backend/.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/secure/era-service-account.json
# Or leave FIREBASE_SERVICE_ACCOUNT_PATH empty to use Application Default Credentials:
# set GOOGLE_APPLICATION_CREDENTIALS to the key file's full path, or run on Google Cloud
# with a service account attached to the host.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/era-service-account.json
